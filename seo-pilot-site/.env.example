# Contentful (Resources: blog, case studies)
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=

# Required for `npm run push-content` (Settings → API keys → Content management tokens)
CONTENTFUL_MANAGEMENT_TOKEN=

# Preview API (blog preview only)
CONTENTFUL_PREVIEW_TOKEN=

# Optional: content model API IDs (override if your Contentful space differs)
# Page – Blog Post
# CONTENTFUL_BLOG_CONTENT_TYPE=pageBlogPost
# Main content field (Rich text). Try: content, body, mainContent
# CONTENTFUL_CONTENT_FIELD=content,body,mainContent,main_content
# FAQs field (Rich text)
# CONTENTFUL_FAQS_FIELD=faqs
# Content Blocks field (Reference array for CTA blocks, rich content blocks)
# CONTENTFUL_CONTENT_BLOCKS_FIELD=contentBlocks
# Page – Case Study
# CONTENTFUL_CASE_STUDY_CONTENT_TYPE=caseStudyPage
# Result Block Component (case study results)
# CONTENTFUL_RESULT_BLOCK_TYPE=resultBlockComponent
# Component – SEO
# CONTENTFUL_SEO_COMPONENT_TYPE=seoComponent
# Component – Author
# CONTENTFUL_AUTHOR_TYPE=authorComponent
# Rich Content Block (embedded in blog content)
# CONTENTFUL_RICH_CONTENT_BLOCK_TYPE=richContentBlock
# CTA Block (embedded in blog content)
# CONTENTFUL_CTA_BLOCK_TYPE=ctaBlock
# Landing Page
# CONTENTFUL_LANDING_PAGE_TYPE=landingPage

# Debug: log warnings (generate script)
# CONTENTFUL_DEBUG=1

# --- push-content overrides ---
# CONTENTFUL_ENVIRONMENT=master
# CONTENTFUL_LOCALE=en-US
# Field IDs (override if your space differs from defaults)
# CONTENTFUL_CS_SLUG_FIELD=adminSlug
# CONTENTFUL_CS_SEO_FIELD=ogSeoFields
# CONTENTFUL_BLOG_SLUG_FIELD=slug
# CONTENTFUL_BLOG_SEO_FIELD=seoFields

# --- index-urls (Google Indexing API + Search Console) ---
# Required:
GSC_PROPERTY_URL=https://theseopilot.pro/
SITE_BASE_URL=https://theseopilot.pro
# Optional: service-account key file (leave UNSET to use `gcloud auth application-default login` ADC instead)
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/Users/<you>/.secrets/gsc-service-account.json
# Optional: relative path to sitemap (default: sitemap.xml)
# SITEMAP_PATH_REL=sitemap.xml
